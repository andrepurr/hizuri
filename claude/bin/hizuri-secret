#!/usr/bin/env node
// hizuri-secret: the user's own Bitwarden vault as a tool the agent can use without ever seeing a
// secret. A secret is typed into the focused window, piped into a command's stdin, or handed to a
// command as one environment variable; it is never printed, logged or written to a file.
//
//   hizuri-secret status                     is the bw CLI there, is the vault unlocked
//   hizuri-secret login                      the user signs in and unlocks, in their own terminal
//   hizuri-secret find <words>               item names and which fields they hold (no values)
//   hizuri-secret type <item> [field]        types the field into the focused window
//   hizuri-secret pipe <item> [field] -- <command…>       the field on the command's stdin
//   hizuri-secret env <item> [field] <VAR> -- <command…>  the field as $VAR for the command
//   hizuri-secret put <name> [--username U] [--uri URL]  the user types a new secret, it goes into the vault
//
// field: password (default), username, totp, notes, or the name of a custom field.
import { spawnSync } from "node:child_process";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

import { HIZURI_HOME, die, ensureDir } from "../lib/hizuri.mjs";

const SESSION = path.join(HIZURI_HOME, "secrets", "bw-session");
const LOCAL_BW = path.join(HIZURI_HOME, "tools", "node_modules", ".bin", "bw");

function bwPath() {
  if (existsSync(LOCAL_BW)) return LOCAL_BW;
  const r = spawnSync("sh", ["-c", "command -v bw"], { encoding: "utf8" });
  if (r.status === 0) return r.stdout.trim();
  die(`hizuri-secret: the Bitwarden CLI is not installed. Install it with:
  npm install --prefix ${path.join(HIZURI_HOME, "tools")} @bitwarden/cli`);
}

function session() {
  return existsSync(SESSION) ? readFileSync(SESSION, "utf8").trim() : "";
}

/** One bw call; its output stays in this process unless the caller passes it on. */
function bw(args, { input, interactive = false } = {}) {
  const env = { ...process.env, BW_SESSION: session(), BW_NOINTERACTION: interactive ? "" : "true" };
  const r = spawnSync(bwPath(), args, {
    env,
    input,
    encoding: "utf8",
    stdio: interactive ? "inherit" : ["pipe", "pipe", "pipe"],
    maxBuffer: 32 * 1024 * 1024,
  });
  if (!interactive && r.status !== 0) {
    const why = (r.stderr || "").split("\n").find((l) => l.trim()) || `bw exited ${r.status}`;
    die(`hizuri-secret: ${why.replace(/\S{24,}/g, "…")}`);
  }
  return r;
}

function status() {
  const r = spawnSync(bwPath(), ["status"], { env: { ...process.env, BW_SESSION: session() }, encoding: "utf8" });
  try {
    return JSON.parse(r.stdout).status;
  } catch {
    return "unknown";
  }
}

function requireUnlocked() {
  const s = status();
  if (s !== "unlocked") {
    die(`hizuri-secret: the vault is ${s}. Ask the user to run, in their own terminal: hizuri-secret login`);
  }
}

function findItem(name) {
  requireUnlocked();
  bw(["sync"]);
  const items = JSON.parse(bw(["list", "items", "--search", name]).stdout);
  const exact = items.filter((i) => i.name.toLowerCase() === name.toLowerCase());
  const pick = exact.length === 1 ? exact : items;
  if (pick.length === 0) die(`hizuri-secret: no item matches “${name}”`);
  if (pick.length > 1) die(`hizuri-secret: “${name}” matches ${pick.length} items: ${pick.map((i) => i.name).join(", ")}`);
  return pick[0];
}

function fieldOf(item, field = "password") {
  let value;
  if (field === "totp") value = bw(["get", "totp", item.id]).stdout.trim();
  else if (field === "password") value = item.login?.password;
  else if (field === "username") value = item.login?.username;
  else if (field === "notes") value = item.notes;
  else if (item.card && field in item.card) value = item.card[field];
  else value = item.fields?.find((f) => f.name === field)?.value;
  if (!value) die(`hizuri-secret: “${item.name}” has no ${field}`);
  return value;
}

function fieldsOf(item) {
  const names = [];
  if (item.login?.username) names.push("username");
  if (item.login?.password) names.push("password");
  if (item.login?.totp) names.push("totp");
  if (item.card) names.push(...Object.keys(item.card).filter((k) => item.card[k]));
  if (item.notes) names.push("notes");
  for (const f of item.fields ?? []) names.push(f.name);
  return names;
}

function typeText(value) {
  const wayland = Boolean(process.env.WAYLAND_DISPLAY);
  const tool = wayland ? ["wtype", ["-"]] : ["xdotool", ["type", "--clearmodifiers", "--file", "-"]];
  const r = spawnSync(tool[0], tool[1], { input: value, stdio: ["pipe", "ignore", "pipe"] });
  if (r.error) die(`hizuri-secret: ${tool[0]} is not installed (it types into the focused window)`);
  if (r.status !== 0) die(`hizuri-secret: ${tool[0]} failed`);
}

function splitCommand(args) {
  const at = args.indexOf("--");
  if (at < 0 || at === args.length - 1) die("hizuri-secret: put the command after --");
  return [args.slice(0, at), args.slice(at + 1)];
}

function readHidden(prompt) {
  if (!process.stdin.isTTY) {
    die("hizuri-secret: put needs the user's own terminal. Ask the user to run this command there.");
  }
  process.stderr.write(prompt);
  spawnSync("stty", ["-echo"], { stdio: "inherit" });
  const r = spawnSync("sh", ["-c", "IFS= read -r line; printf %s \"$line\""], { stdio: ["inherit", "pipe", "inherit"], encoding: "utf8" });
  spawnSync("stty", ["echo"], { stdio: "inherit" });
  process.stderr.write("\n");
  return r.stdout;
}

const [command, ...args] = process.argv.slice(2);
switch (command) {
  case "status":
    console.log(`bitwarden cli: ${bwPath()} · vault: ${status()}`);
    break;
  case "login": {
    if (!process.stdin.isTTY) die("hizuri-secret: login needs the user's own terminal; ask the user to run: hizuri-secret login");
    if (status() === "unauthenticated") bw(["login"], { interactive: true });
    const r = spawnSync(bwPath(), ["unlock", "--raw"], { stdio: ["inherit", "pipe", "inherit"], encoding: "utf8" });
    if (r.status !== 0 || !r.stdout.trim()) die("hizuri-secret: the vault stayed locked");
    ensureDir(path.dirname(SESSION));
    writeFileSync(SESSION, r.stdout.trim(), { mode: 0o600 });
    console.log("hizuri-secret: vault unlocked for the agent (session kept in ~/.hizuri/secrets, readable by you only)");
    break;
  }
  case "find": {
    requireUnlocked();
    const items = JSON.parse(bw(["list", "items", "--search", args.join(" ")]).stdout);
    for (const i of items.slice(0, 20)) console.log(`${i.name} · fields: ${fieldsOf(i).join(", ") || "none"}`);
    if (items.length === 0) console.log("no matching items");
    break;
  }
  case "type": {
    const [name, field] = args;
    if (!name) die("usage: hizuri-secret type <item> [field]");
    typeText(fieldOf(findItem(name), field));
    console.log(`typed the ${field ?? "password"} of “${name}”`);
    break;
  }
  case "pipe": {
    const [head, cmd] = splitCommand(args);
    const value = fieldOf(findItem(head[0]), head[1]);
    const r = spawnSync(cmd[0], cmd.slice(1), { input: value, stdio: ["pipe", "inherit", "inherit"] });
    process.exit(r.status ?? 1);
  }
  case "env": {
    const [head, cmd] = splitCommand(args);
    const [name, field, variable] = head.length >= 3 ? head : [head[0], "password", head[1]];
    if (!variable) die("usage: hizuri-secret env <item> [field] <VAR> -- <command…>");
    const value = fieldOf(findItem(name), field);
    const r = spawnSync(cmd[0], cmd.slice(1), { env: { ...process.env, [variable]: value }, stdio: "inherit" });
    process.exit(r.status ?? 1);
  }
  case "put": {
    const name = args[0];
    if (!name) die("usage: hizuri-secret put <name> [--username U] [--uri URL]");
    requireUnlocked();
    const opt = (flag) => {
      const i = args.indexOf(flag);
      return i > 0 ? args[i + 1] : undefined;
    };
    const secret = readHidden(`Secret for “${name}” (not shown): `);
    if (!secret) die("hizuri-secret: nothing typed, nothing saved");
    const uri = opt("--uri");
    const item = {
      type: 1,
      name,
      notes: null,
      login: { username: opt("--username") ?? null, password: secret, uris: uri ? [{ match: null, uri }] : [] },
    };
    const encoded = Buffer.from(JSON.stringify(item)).toString("base64");
    // On stdin, not as an argument: a command line is visible to every process of this user.
    bw(["create", "item"], { input: encoded });
    console.log(`hizuri-secret: “${name}” saved in the vault`);
    break;
  }
  default:
    console.error("usage: hizuri-secret status | login | find <words> | type <item> [field] | pipe <item> [field] -- <cmd> | env <item> [field] <VAR> -- <cmd> | put <name>");
    process.exit(command ? 2 : 0);
}
